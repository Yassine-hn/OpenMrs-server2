# OpenMrs-server2 Environment Configuration
# Copy this file to .env and adjust values if needed.

# Host ports
ASSISTANT_PORT=8000
VLLM_PORT=8001
MONAI_PORT=8002
OHIF_AI_PORT=1026
STT_GATEWAY_PORT=8003
STT_ENGINE_PORT=8004

# Model configuration (FP8 Quantized MedGemma on RTX 5070 Ti)
LLM_MODEL_DIR=/home/cerist/models
LLM_MODEL_PATH=/models/medgemma-quant/medgemma-1.5-4b-it-variant-C-fp8
LLM_MODEL_NAME=medgemma-1.5-4b-it

# GPU memory utilization
LLM_GPU_MEMORY_UTILIZATION=0.50
LLM_MAX_MODEL_LEN=4096
LLM_MAX_NUM_SEQS=8

# STT Engine (Qwen3-ASR-0.6B)
STT_MODEL=Qwen3-ASR-0.6B
STT_MODEL_PATH=Qwen/Qwen3-ASR-0.6B
STT_GPU_FRACTION=0.20

# MONAI Label paths
MONAI_STATE_DIR=/home/cerist/ohif-ai-eval/monai-label

# Service URLs
LLM_BASE_URL=http://vllm:8000/v1
OPENMRS_BASE_URL=http://10.0.211.249
ORTHANC_DICOMWEB_URL=http://10.0.211.249:8042/dicom-web
